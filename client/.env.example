# Supabase — https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Maptiler — map tiles + geocoding (free at maptiler.com, 100k/month)
EXPO_PUBLIC_MAPTILER_KEY=
# OpenRouteService — road-following directions (free at openrouteservice.org, 2000/day)
EXPO_PUBLIC_ORS_API_KEY=

# Google Maps — required for native map rendering on iOS/Android (app.config.js
# reads this as plain GOOGLE_MAPS_API_KEY, not EXPO_PUBLIC_-prefixed, since it's
# only needed at build/prebuild time, not in the JS bundle). Get one at
# https://console.cloud.google.com/google/maps-apis — currently unset; see
# wakaway/Architecture.md "Current state / open threads".
GOOGLE_MAPS_API_KEY=

# Sentry — crash reporting (get a DSN at sentry.io, free tier is fine).
# Left unset, Sentry.init() is skipped and the app runs without crash
# reporting rather than crashing on a missing DSN.
EXPO_PUBLIC_SENTRY_DSN=

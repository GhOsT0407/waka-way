# Copy this file to .env and fill in your values
# Never commit .env to git

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Local SQLite (dev only)
DATABASE_URL=sqlite:///db.sqlite3

# Supabase PostgreSQL (production)
# DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:19000,exp://localhost:19000
